# Supplied reference material - never part of the GitHub submission.
sdev/

# Secrets - never commit.
.env
*.pem
*.key

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/
env/
build/
dist/

# Coverage artifacts
.coverage
.coverage.*
htmlcov/
coverage.xml

# OS metadata
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Logs / scratch
*.log
.env.local

# Frontend (frontend/.gitignore also covers these locally)
frontend/node_modules/
frontend/dist/
frontend/.env.local

# Pipeline working state - regenerated by every analyze/generate/validate/
# review run, not itself a versioned deliverable (see README.md #11).
artifacts/

# output/ - development/test-range generated artifacts (paper_number 900+)
# are not part of the Phase 1 submission. The canonical paper-01 and
# paper-02 deliverables are explicitly re-included below and must stay
# tracked.
output/*
!output/mock-eisa-paper-01.*
!output/mock-eisa-memo-01.*
!output/mock-eisa-paper-02.*
!output/mock-eisa-memo-02.*
