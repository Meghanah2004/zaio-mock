# Copy this file to .env and fill in real values. NEVER commit the real .env.
#
# LLM_PROVIDER controls which provider src/providers/factory.py builds:
#   mock      - deterministic, offline, no network access, no API key needed.
#               Always used by the automated test suite regardless of this
#               setting (see tests/conftest.py) and by any developer without
#               a configured provider key. NOT what output/mock-eisa-paper-
#               01.*/-02.* were generated with - those are real Groq output
#               (LLM_PROVIDER=groq below is the current production choice).
#   anthropic - calls the real Anthropic Messages API. Requires ANTHROPIC_API_KEY.
#   gemini    - calls the real Google Gemini API (Google GenAI SDK).
#               Requires GEMINI_API_KEY.
#   groq      - calls the real Groq API (official Groq Python SDK, OpenAI-
#               compatible chat completions). Requires GROQ_API_KEY.
#
# IMPORTANT: a Claude Pro/Max subscription (e.g. Claude Code, claude.ai) does
# NOT provide an API key usable here. An Anthropic API key is a separate
# credential issued via https://console.anthropic.com (pay-as-you-go billing).
# Likewise, a GEMINI_API_KEY is issued via https://aistudio.google.com/apikey
# (or a Google Cloud project), and a GROQ_API_KEY via https://console.groq.com
# - a general Google/other account alone does not provide either. If you
# don't have any of these, leave LLM_PROVIDER=mock - the pipeline is fully
# functional without it.
LLM_PROVIDER=mock

# PRODUCTION HARDENING: when a real provider is configured (LLM_PROVIDER=
# groq/anthropic/gemini) but its API key is missing/blank/misspelled,
# src/providers/factory.py's default behavior is a stderr WARNING followed
# by a silent fallback to MockProvider - safe for local development (no
# key = no crash, still fully usable offline), but a real risk for an
# unattended deployment whose logs aren't watched: it would serve fake
# fixture content as if it were real, learner-guide-grounded generation,
# with nothing louder than a log line to notice. Set this to true in a
# production deployment to turn that same condition (including
# LLM_PROVIDER being left at its "mock" default entirely) into a hard,
# immediate failure instead. Leave unset/false everywhere else - it
# defaults to false and nothing in local dev, the CLI, or the test suite
# ever needs it set.
REQUIRE_REAL_PROVIDER=false

# Only required if LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Only required if LLM_PROVIDER=gemini. NEVER put a real key in this
# .env.example file - copy it to .env (gitignored) and set it there.
GEMINI_API_KEY=

# Only required if LLM_PROVIDER=groq. NEVER put a real key in this
# .env.example file - copy it to .env (gitignored) and set it there.
GROQ_API_KEY=

# Optional overrides (sensible defaults are used if omitted).
ANTHROPIC_MODEL=claude-sonnet-5
# "gemini-2.5-flash" is no longer available to new Gemini API keys (Google's
# API itself returns 404 and points to gemini-3.6-flash as of this
# project's last real-API check) - set this to whatever model your key can
# actually reach if that changes again.
GEMINI_MODEL=gemini-3.6-flash
GROQ_MODEL=openai/gpt-oss-120b
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.4

# ---------------------------------------------------------------------------
# Security configuration (src/security/config.py is the single source of
# truth - every value below has a safe built-in default and does not need
# to be set). See docs/SECURITY-AUDIT.md for what each bound protects.
# ---------------------------------------------------------------------------

# Reference ingestion bounds (src/ingestion/pdf_loader.py)
MAX_REFERENCE_FILE_SIZE_MB=100
MAX_REFERENCE_FILE_COUNT=2000
MAX_FILENAME_LENGTH=255

# Provider / generation bounds
MAX_PROVIDER_RESPONSE_CHARS=200000
MAX_REFERENCE_DERIVED_TEXT_LENGTH=200
GENERATION_MAX_RETRIES=3
GENERATION_RETRY_BACKOFF_SECONDS=1.0
PROVIDER_TIMEOUT_SECONDS=60

# Retrieval / grounding bounds (src/retrieval/, src/validation/grounding_validator.py)
MAX_EVIDENCE_PASSAGE_CHARS=900
EVIDENCE_PASSAGES_PER_SECTION=4
GROUNDING_MIN_OVERLAP=0.08
GROUNDING_MAX_OVERLAP=0.75
CROSS_PAPER_MAX_SIMILARITY=0.6
GROUNDING_MAX_RETRIES=3
MEMO_MAX_RETRIES=3
ANSWER_GROUNDING_MIN_OVERLAP=0.08
ANSWER_RELEVANCE_MIN_OVERLAP=0.05

# CLI argument bounds
MIN_PAPER_NUMBER=1
MAX_PAPER_NUMBER=9999
MIN_SEED=0
MAX_SEED=2147483647

# Rate limiting - ACTIVELY ENFORCED on every api/ endpoint (see
# docs/API.md). GENERATION_* governs POST /api/generate; READ_* governs
# /api/health and /api/results/*.
RATE_LIMIT_ENABLED=true
GENERATION_RATE_LIMIT=5
GENERATION_RATE_WINDOW_SECONDS=60
GENERATION_BURST=2
READ_RATE_LIMIT=60
READ_RATE_WINDOW_SECONDS=60

# API layer (api/) - see docs/API.md.
# Comma-separated allow-list for CORS. NEVER "*". Defaults are common local
# frontend dev ports; set this to your real deployed frontend origin(s) in
# production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Reject any request body larger than this before it reaches Pydantic
# parsing. Generation requests are a handful of small fields.
MAX_REQUEST_BODY_BYTES=16384
