# Copy this file to .env and fill in real values. NEVER commit the real .env.
#
# LLM_PROVIDER controls which provider src/providers/factory.py builds:
#   mock      - deterministic, offline, no network access, no API key needed.
#               This is the default and is what Phase 1's shipped artifacts
#               under output/ were generated with.
#   anthropic - calls the real Anthropic Messages API. Requires ANTHROPIC_API_KEY.
#
# IMPORTANT: a Claude Pro/Max subscription (e.g. Claude Code, claude.ai) does
# NOT provide an API key usable here. An Anthropic API key is a separate
# credential issued via https://console.anthropic.com (pay-as-you-go billing).
# If you don't have one, leave LLM_PROVIDER=mock - the pipeline is fully
# functional without it.
LLM_PROVIDER=mock

# Only required if LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Optional overrides (sensible defaults are used if omitted).
ANTHROPIC_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.4

# ---------------------------------------------------------------------------
# Security configuration (src/security/config.py is the single source of
# truth - every value below has a safe built-in default and does not need
# to be set). See docs/SECURITY-AUDIT.md for what each bound protects.
# ---------------------------------------------------------------------------

# Reference ingestion bounds (src/ingestion/pdf_loader.py)
MAX_REFERENCE_FILE_SIZE_MB=100
MAX_REFERENCE_FILE_COUNT=2000
MAX_FILENAME_LENGTH=255

# Provider / generation bounds
MAX_PROVIDER_RESPONSE_CHARS=200000
MAX_REFERENCE_DERIVED_TEXT_LENGTH=200
GENERATION_MAX_RETRIES=3
GENERATION_RETRY_BACKOFF_SECONDS=1.0
PROVIDER_TIMEOUT_SECONDS=60

# CLI argument bounds
MIN_PAPER_NUMBER=1
MAX_PAPER_NUMBER=9999
MIN_SEED=0
MAX_SEED=2147483647

# Rate limiting - ACTIVELY ENFORCED on every api/ endpoint (see
# docs/API.md). GENERATION_* governs POST /api/generate; READ_* governs
# /api/health and /api/results/*.
RATE_LIMIT_ENABLED=true
GENERATION_RATE_LIMIT=5
GENERATION_RATE_WINDOW_SECONDS=60
GENERATION_BURST=2
READ_RATE_LIMIT=60
READ_RATE_WINDOW_SECONDS=60

# API layer (api/) - see docs/API.md.
# Comma-separated allow-list for CORS. NEVER "*". Defaults are common local
# frontend dev ports; set this to your real deployed frontend origin(s) in
# production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Reject any request body larger than this before it reaches Pydantic
# parsing. Generation requests are a handful of small fields.
MAX_REQUEST_BODY_BYTES=16384
