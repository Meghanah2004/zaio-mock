# Copy to .env.local for local development (Vite loads .env.local automatically
# and it is already gitignored). Never put secrets in frontend env vars - every
# VITE_ prefixed variable is embedded in the built JS bundle and is public.

# Base URL of the FastAPI backend (see ../docs/API.md). Defaults to
# http://127.0.0.1:8000 if unset, matching `uvicorn api.app:app --reload`
# (which binds 127.0.0.1 explicitly).
#
# Use 127.0.0.1, not localhost: on some machines `localhost` resolves to
# ::1 (IPv6) before 127.0.0.1, and if any OTHER local process happens to
# be bound to port 8000 on the wildcard/IPv6 address, requests to
# `localhost:8000` can silently reach that unrelated process instead of
# this backend - not a crash, not a CORS error, just the wrong server
# answering. If Generate reaches the backend but consistently fails with a
# generic error, check `lsof -nP -iTCP:8000 -sTCP:LISTEN` for a port
# collision before assuming this project's code is at fault.
VITE_API_BASE_URL=http://127.0.0.1:8000
